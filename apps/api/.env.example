# Prāṇa Yoga Platform - Backend Environment Configuration

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL 15+ with btree_gist extension)
# For local Docker: postgresql://postgres:postgres@localhost:5432/prana_yoga?schema=public
# For Supabase / Neon: postgresql://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prana_yoga?schema=public"

# Razorpay Payment Gateway (Live or Test keys)
# Get keys from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID="rzp_test_yoga_platform_key"
RAZORPAY_KEY_SECRET="rzp_test_secret_yoga_platform"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_prana_2026"

# Slot Hold TTL in seconds (10 minutes)
SLOT_HOLD_TTL_SECONDS=600
