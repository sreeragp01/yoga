{
  "name": "yoga-platform",
  "version": "1.0.0",
  "description": "Prāṇa Yoga Booking Platform - Unified Web & API Architecture",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,WEB\" -c \"magenta,cyan\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:api": "npm --prefix apps/api run dev",
    "build": "vite build",
    "build:api": "npm --prefix apps/api run build",
    "preview": "vite preview",
    "db:generate": "npm --prefix apps/api run prisma:generate",
    "db:migrate": "npm --prefix apps/api run prisma:migrate",
    "db:seed": "npm --prefix apps/api run prisma:seed"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
